# Copy this file to .env and fill in a newly rotated key.
VOLC_ASR_API_KEY=

# Probe Model 2.0/1.0 and duration/concurrency grants in order.
VOLC_ASR_RESOURCE_IDS=volc.seedasr.sauc.duration,volc.seedasr.sauc.concurrent,volc.bigasr.sauc.duration,volc.bigasr.sauc.concurrent

VOICE_TTS_FALLBACK_PROVIDER=

# Full-duplex barge-in. TTS PCM is used as the far-end reference so the
# local microphones can reject EV's own voice and detect double-talk.
VOICE_BARGE_IN=1
VOICE_ECHO_MAX_DELAY_MS=2200
VOICE_ECHO_TAIL_MS=900
VOICE_ECHO_CALIBRATION_MS=500
VOICE_BARGE_IN_MIN_RMS=360
VOICE_BARGE_IN_CONFIRM_FRAMES=12
VOICE_BARGE_IN_PREROLL_FRAMES=22
VOICE_BARGE_IN_MAX_SPECTRAL_SIMILARITY=0.88
VOICE_ECHO_SIMILARITY_VETO=0.94

# Microphone sensitivity. These defaults favor quiet speech while the adaptive
# noise floor prevents steady room noise from opening the VAD.
VOICE_INPUT_GAIN=1.5
VOICE_VAD_MODE=2
VOICE_PADDING_FRAMES=18
VOICE_VAD_TRIGGER_RATIO=0.60
VOICE_ASR_EARLY_FINISH_MS=0
VOICE_MIN_FRAMES=6
# WS2812 灯带 ESP32（ws2812-lan-control 固件）。mDNS 解析不了时改具体 IP，如 http://192.168.2.81
LED_DEVICE_URL=http://ws2812.local
LED_MCP_PORT=8012
LED_REQUEST_TIMEOUT=2.5
VOICE_MAX_UTT_SECONDS=30
VOICE_LATENCY_FILLER=0
VOICE_OUTPUT_DEVICE=1
